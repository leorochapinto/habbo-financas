# Senha do painel (HTTP Basic). Sem APP_SENHA o painel fica aberto: só use assim na sua máquina.
APP_USUARIO=admin
APP_SENHA=

# Endereço público do sistema (o PicPay chama APP_URL/api/picpay/callback quando um pagamento muda).
APP_URL=https://financas.seudominio.com.br

# Credenciais da API de E-commerce do PicPay (painel PicPay Empresas > integrações).
# Sem PICPAY_TOKEN o sistema roda em modo simulado.
PICPAY_TOKEN=
PICPAY_SELLER_TOKEN=
# Para onde o jogador volta depois de pagar (opcional; padrão = APP_URL).
PICPAY_RETURN_URL=

# Caminho do banco SQLite (opcional; padrão = ./data/financas.db).
DATABASE_PATH=
